# Claude API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# LinkedIn app (https://www.linkedin.com/developers/apps) with the products
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Add the redirect URL below under Auth > Authorized redirect URLs.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Optional: pin the LinkedIn API version (YYYYMM). By default recent versions are tried.
# LINKEDIN_API_VERSION=

# Firecrawl (https://firecrawl.dev) for scraping company careers pages
FIRECRAWL_API_KEY=

# Email tracking. Gmail: turn on 2-step verification, then create an App Password
# at https://myaccount.google.com/apppasswords (not your normal password).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Optional: send the daily digest somewhere else
# DIGEST_TO=
